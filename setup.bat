@echo off
chcp 65001 >nul
title PowerMill AI - установка (полная)
cd /d "%~dp0"

echo =========================================================
echo   ПОЛНАЯ УСТАНОВКА
echo =========================================================
echo.
echo Этот файл раньше прописывал переменные окружения и диск E: вручную.
echo Теперь установка одна - install.bat: он спрашивает папку данных,
echo создаёт окружение .venv, ставит библиотеки, делает ярлыки и макросы,
echo и запоминает всё в install.json (переменные окружения не нужны).
echo.
echo Передаю в install.bat.
echo.

call "%~dp0install.bat" %*
exit /b %ERRORLEVEL%
